#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Start Up Batch script for Unix/Linux/macOS
# ----------------------------------------------------------------------------

which mvn >/dev/null 2>&1
if [ $? -eq 0 ]; then
  exec mvn "$@"
fi

PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
APP_DIR="`pwd -P`"
cd "$SAVED" >/dev/null

MVN_CMD="$APP_DIR/.mvn-runtime/apache-maven-3.9.11/bin/mvn"
if [ -x "$MVN_CMD" ]; then
  exec "$MVN_CMD" "$@"
fi

echo "Maven not found. Please install Apache Maven or run from a container." >&2
exit 1
